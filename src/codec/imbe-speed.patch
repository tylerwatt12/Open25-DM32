+// Convert a Q31 butterfly result to Q15 with the original saturated rounding.
+static inline Word16 fft_round(Word32 value)
+{
+    if (value > MAX_32 - 0x8000)
+        return MAX_16;
+    return (Word16)((value + 0x8000) >> 16);
+}
+
+static inline void fft_butterfly(Word16 &top, Word16 &bottom, Word32 product)
+{
+    const Word32 value = (Word32)top * 32768;
+    Word32 sum, difference;
+    const Word16 limit = value < 0 ? MIN_16 : MAX_16;
+    top = __builtin_add_overflow(value, product, &sum) ? limit : fft_round(sum);
+    bottom = __builtin_sub_overflow(value, product, &difference) ? limit : fft_round(difference);
+}
+
+void imbe_vocoder_impl::fft(Word16 *data, Word16 isign)
+{
+    const int length = 2 * FFTLENGTH;
+    int reversed = 0;
+    for (int i = 0; i < length; i += 2)
+    {
+        if (reversed > i)
+        {
+            const Word16 real = data[i];
+            const Word16 imag = data[i + 1];
+            data[i] = data[reversed];
+            data[i + 1] = data[reversed + 1];
+            data[reversed] = real;
+            data[reversed + 1] = imag;
+        }
+        int bit = FFTLENGTH;
+        while (bit >= 2 && reversed >= bit)
+        {
+            reversed -= bit;
+            bit >>= 1;
+        }
+        reversed += bit;
+    }
+
+    int twiddle_step = FFTLENGTH;
+    for (int half = 2; half < length; half *= 2)
+    {
+        const int stride = 2 * half;
+        twiddle_step >>= 1;
+
+        // The first twiddle is (32767, 0) in Q15. Its cross terms vanish.
+        for (int i = 0; i < length; i += stride)
+        {
+            const int j = i + half;
+            fft_butterfly(data[i], data[j], (Word32)data[j] * ONE_Q15);
+            fft_butterfly(data[i + 1], data[j + 1], (Word32)data[j + 1] * ONE_Q15);
+        }
+
+        int index = twiddle_step;
+        for (int offset = 2; offset < half; offset += 2, index += twiddle_step)
+        {
+            const Cmplx16 coefficient = fft_twiddle(index);
+            const Word32 wr = coefficient.re;
+            const Word32 wi = isign < 0 ? -(Word32)coefficient.im : coefficient.im;
+            for (int i = offset; i < length; i += stride)
+            {
+                const int j = i + half;
+                // Twiddles have magnitude at most 32767. L_mult(a,b)>>1
+                // equals a*b here, and 2*32767*32768 fits in Word32.
+                const Word32 real = wr * data[j] - wi * data[j + 1];
+                const Word32 imag = wr * data[j + 1] + wi * data[j];
+                fft_butterfly(data[i], data[j], real);
+                fft_butterfly(data[i + 1], data[j + 1], imag);
+            }
+        }
+    }
+}
